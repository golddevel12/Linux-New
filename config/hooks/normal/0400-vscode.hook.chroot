#!/bin/sh
# Installeert Visual Studio Code (Microsoft-repo). Optioneel - verwijder
# dit bestand als je liever alleen Neovim + Claude Code gebruikt.
set -e
echo "I: VS Code installeren..."

install -d -m 0755 /etc/apt/keyrings
if curl -fsSL https://packages.microsoft.com/keys/microsoft.asc \
        | gpg --dearmor -o /etc/apt/keyrings/packages.microsoft.gpg; then
    echo "deb [arch=amd64,arm64,armhf signed-by=/etc/apt/keyrings/packages.microsoft.gpg] https://packages.microsoft.com/repos/code stable main" \
        > /etc/apt/sources.list.d/vscode.list
    apt-get update
    if apt-get install -y code; then
        echo "I: VS Code geïnstalleerd."
    else
        echo "W: VS Code kon niet geïnstalleerd worden - overgeslagen."
    fi
else
    echo "W: Microsoft-sleutel niet op te halen - VS Code overgeslagen."
fi
