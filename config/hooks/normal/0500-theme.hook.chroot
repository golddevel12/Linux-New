#!/bin/sh
# Apple-achtig uiterlijk: WhiteSur-thema + Dash-to-Dock + donkere modus,
# wallpaper en logo. De dconf-standaarden worden altijd gezet; lukt het
# ophalen van het WhiteSur-thema niet, dan valt GNOME terug op Adwaita-dark.
set -e
echo "I: BearlyOS-thema instellen..."

# ── WhiteSur GTK- en icon-thema ophalen en systeembreed installeren ──
TMP="$(mktemp -d)"
if git clone --depth=1 https://github.com/vinceliuice/WhiteSur-gtk-theme.git "$TMP/gtk"; then
    ( cd "$TMP/gtk" && ./install.sh -d /usr/share/themes -c Dark -t default -N glassy ) \
        || echo "W: WhiteSur GTK-thema niet volledig geïnstalleerd."
else
    echo "W: WhiteSur GTK-thema niet op te halen."
fi
if git clone --depth=1 https://github.com/vinceliuice/WhiteSur-icon-theme.git "$TMP/icons"; then
    ( cd "$TMP/icons" && ./install.sh -d /usr/share/icons -b ) \
        || echo "W: WhiteSur icon-thema niet volledig geïnstalleerd."
else
    echo "W: WhiteSur icon-thema niet op te halen."
fi
rm -rf "$TMP"

# ── dconf-standaarden voor alle gebruikers ──────────────────────────
mkdir -p /etc/dconf/profile /etc/dconf/db/local.d
cat > /etc/dconf/profile/user <<'EOF'
user-db:user
system-db:local
EOF

cat > /etc/dconf/db/local.d/00-bearlyos <<'EOF'
[org/gnome/desktop/interface]
color-scheme='prefer-dark'
gtk-theme='WhiteSur-Dark'
icon-theme='WhiteSur-dark'
enable-animations=true
font-name='Cantarell 11'
monospace-font-name='Fira Code 11'

[org/gnome/shell/extensions/user-theme]
name='WhiteSur-Dark'

[org/gnome/desktop/background]
picture-uri='file:///usr/share/backgrounds/bearly/wallpaper-dark.png'
picture-uri-dark='file:///usr/share/backgrounds/bearly/wallpaper-dark.png'
picture-options='zoom'
primary-color='#070708'

[org/gnome/desktop/screensaver]
picture-uri='file:///usr/share/backgrounds/bearly/wallpaper-dark.png'
primary-color='#070708'

[org/gnome/shell]
enabled-extensions=['dash-to-dock@micxgx.gmail.com', 'user-theme@gnome-shell-extensions.gcampax.github.com']
favorite-apps=['brave-browser.desktop', 'org.gnome.Terminal.desktop', 'code.desktop', 'org.gnome.Nautilus.desktop', 'org.gnome.Settings.desktop']

[org/gnome/shell/extensions/dash-to-dock]
dock-position='BOTTOM'
extend-height=false
dock-fixed=false
autohide=true
intellihide=true
transparency-mode='DYNAMIC'
running-indicator-style='DOTS'
show-apps-at-top=false
click-action='minimize'
custom-theme-shrink=true
dash-max-icon-size=48
show-mounts=false
show-trash=false

[org/gnome/mutter]
center-new-windows=true
dynamic-workspaces=true

[org/gnome/desktop/wm/preferences]
button-layout='close,minimize,maximize:'
EOF

dconf update || echo "W: dconf update gaf een waarschuwing."

# ── Loginscherm (GDM): donker + jouw logo ──────────────────────────
mkdir -p /etc/dconf/db/gdm.d
if [ ! -f /etc/dconf/profile/gdm ]; then
cat > /etc/dconf/profile/gdm <<'EOF'
user-db:user
system-db:gdm
file-db:/usr/share/gdm/greeter-dconf-defaults
EOF
fi
cat > /etc/dconf/db/gdm.d/01-bearly <<'EOF'
[org/gnome/login-screen]
logo='/usr/share/pixmaps/bearly-logo.png'
disable-user-list=false

[org/gnome/desktop/interface]
color-scheme='prefer-dark'
gtk-theme='WhiteSur-Dark'
EOF
dconf update || true

echo "I: Thema klaar."
