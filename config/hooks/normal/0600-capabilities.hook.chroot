#!/bin/sh
# Wifi-capture zonder root + de Bearly-IT opstartanimatie (Plymouth) activeren.
set -e

# ── Wireshark/tcpdump zonder sudo laten capturen ───────────────────
if [ -x /usr/bin/dumpcap ]; then
    setcap 'cap_net_raw,cap_net_admin=eip' /usr/bin/dumpcap 2>/dev/null \
        || echo "W: setcap op dumpcap mislukt."
fi

# ── Bearly-IT opstartscherm instellen ──────────────────────────────
if [ -d /usr/share/plymouth/themes/bearlyos ]; then
    if command -v plymouth-set-default-theme >/dev/null 2>&1; then
        plymouth-set-default-theme bearlyos 2>/dev/null || \
            echo "W: kon Plymouth-thema niet als standaard zetten."
    fi
    # 'splash' staat al in de bootappend; initramfs wordt door live-build
    # opnieuw gebouwd, dus het thema wordt meegenomen.
    update-initramfs -u 2>/dev/null || true
fi
