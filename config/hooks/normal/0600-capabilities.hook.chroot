#!/bin/sh
# Laat wifi-captures en packet-sniffing zonder root werken (voor jouw werk),
# en zet een macOS-achtige Plymouth-opstartanimatie met jouw logo.
set -e

# ── Wireshark/tcpdump zonder sudo laten capturen ───────────────────
if [ -x /usr/bin/dumpcap ]; then
    setcap 'cap_net_raw,cap_net_admin=eip' /usr/bin/dumpcap 2>/dev/null \
        || echo "W: setcap op dumpcap mislukt."
fi

# ── Plymouth-opstartscherm ─────────────────────────────────────────
if [ -d /usr/share/plymouth/themes/spinner ]; then
    # Jouw logo als watermerk tijdens het opstarten
    if [ -f /usr/share/pixmaps/bearly-logo.png ]; then
        cp /usr/share/pixmaps/bearly-logo.png \
           /usr/share/plymouth/themes/spinner/watermark.png 2>/dev/null || true
    fi
    plymouth-set-default-theme spinner 2>/dev/null || true
fi
