#!/bin/sh
# Live-sessie: gebruiker 'bear' staat al in het image (passwd/shadow);
# hier alleen home-map en sudo-regel regelen. Niet op een geinstalleerd systeem.
set -e
if id bear >/dev/null 2>&1; then
    if [ ! -d /home/bear ]; then
        mkdir -p /home/bear
        cp -a /etc/skel/. /home/bear/
    fi
    chown -R bear:bear /home/bear
else
    useradd -m -G wheel -s /bin/bash bear && passwd -d bear
fi
passwd -d bear >/dev/null 2>&1 || true
for g in video audio input network storage power; do
    getent group "$g" >/dev/null 2>&1 && usermod -aG "$g" bear || true
done
echo '%wheel ALL=(ALL) NOPASSWD: ALL' > /etc/sudoers.d/10-bearly-live
chmod 0440 /etc/sudoers.d/10-bearly-live
