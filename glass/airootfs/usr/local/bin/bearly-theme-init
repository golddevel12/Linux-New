#!/bin/sh
# Kiest bij het inloggen het mooiste beschikbare thema (WhiteSur als dat
# geinstalleerd is, anders Adwaita-dark + Papirus) en schrijft GTK/Qt-instellingen.
# Bestanden die de gebruiker zelf heeft aangepast (zonder marker) blijven staan.
MARK="# bearly-managed"

if [ -d /usr/share/themes/WhiteSur-Dark ]; then GTK=WhiteSur-Dark; else GTK=Adwaita-dark; fi
if [ -d /usr/share/icons/WhiteSur-dark ]; then ICON=WhiteSur-dark; else ICON=Papirus-Dark; fi

write_gtk() {
    f="$1"
    mkdir -p "$(dirname "$f")"
    if [ ! -f "$f" ] || grep -q "$MARK" "$f"; then
        cat > "$f" <<EOF
$MARK
[Settings]
gtk-theme-name=$GTK
gtk-icon-theme-name=$ICON
gtk-font-name=Noto Sans 10
gtk-application-prefer-dark-theme=1
gtk-cursor-theme-name=Adwaita
EOF
    fi
}
write_gtk "$HOME/.config/gtk-3.0/settings.ini"
write_gtk "$HOME/.config/gtk-4.0/settings.ini"

# KDE/Qt-programma's (Dolphin) gebruiken hetzelfde icoonthema
K="$HOME/.config/kdeglobals"
if [ ! -f "$K" ] || grep -q "$MARK" "$K"; then
    cat > "$K" <<EOF
$MARK
[Icons]
Theme=$ICON
EOF
fi
exit 0
