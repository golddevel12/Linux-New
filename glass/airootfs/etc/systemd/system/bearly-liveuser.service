[Unit]
Description=BearlyOS Glass: live-gebruiker voorbereiden
# Alleen in de live-ISO (archiso), voordat de login-manager start.
ConditionPathExists=/run/archiso
Before=display-manager.service sddm.service
After=local-fs.target

[Service]
Type=oneshot
ExecStart=/bin/sh /usr/local/bin/bearly-liveuser
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target
