[Unit]
Description=BearlyOS Glass eerste start: hardware-detectie en drivers
# Alleen op een geinstalleerd systeem (in de live-ISO bestaat /run/archiso), eenmalig.
ConditionPathExists=!/run/archiso
ConditionPathExists=!/var/lib/bearly-firstboot.done
After=network.target NetworkManager.service

[Service]
Type=simple
ExecStart=/bin/sh /usr/local/bin/bearly-firstboot
TimeoutStartSec=0

[Install]
WantedBy=multi-user.target
